# Sanity project. Required to build/serve the site.
NEXT_PUBLIC_SANITY_PROJECT_ID=replace_with_sanity_project_id
NEXT_PUBLIC_SANITY_DATASET=production

# Resend credentials and verified sender identity
RESEND_API_KEY=re_replace_with_your_key
CONTACT_FROM_EMAIL=IFEM Education <enquiries@ifemeducation.com>
# Used only when Sanity has no usable branch email.
CONTACT_FALLBACK_EMAIL=contact@ifemeducation.com

# Cloudflare Turnstile. Use a real widget's keys in production. The secret
# remains server-only; the site key is intentionally public to the browser.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=replace_with_cloudflare_site_key
TURNSTILE_SECRET_KEY=replace_with_cloudflare_secret_key
TURNSTILE_ENABLED=true

# Randomly route each contact form delivery through one branch email configured in Sanity.
CONTACT_EMAIL_ROTATION_ENABLED=true
# Optional emergency/test destination. This bypasses random branch routing.
CONTACT_RECIPIENT_OVERRIDE=

# Optional webhook forwards for each form.
CONTACT_WEBHOOK_URL=
NEWSLETTER_WEBHOOK_URL=

# Keep newsletter submission disabled until an email-list provider is configured.
NEWSLETTER_ENABLED=false
