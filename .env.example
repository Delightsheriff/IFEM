# Resend credentials and verified sender identity
RESEND_API_KEY=re_replace_with_your_key
CONTACT_FROM_EMAIL=IFEM Education <enquiries@updates.ifemeducation.com>

# Cloudflare Turnstile. Use a real widget's keys in production. The secret
# remains server-only; the site key is intentionally public to the browser.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=replace_with_cloudflare_site_key
TURNSTILE_SECRET_KEY=replace_with_cloudflare_secret_key
TURNSTILE_ENABLED=true

# Keep this false while testing: all contact-form messages will go to the
# override inbox. Remove the override and set this to true to rotate through
# the branch emails configured in Sanity.
CONTACT_EMAIL_ROTATION_ENABLED=false
CONTACT_RECIPIENT_OVERRIDE=delightsheriff@gmail.com
